# Sa.To DiagnosticAI — Environment Variables
# Copia questo file in .env.local e inserisci la tua chiave API

# Anthropic API Key (necessaria per girare in locale)
# Ottienila su: https://console.anthropic.com
VITE_ANTHROPIC_API_KEY=sk-ant-api03-...

# Ambiente (development | production)
VITE_APP_ENV=development

# Limite scansioni Free (default: 5)
VITE_FREE_SCAN_LIMIT=5
